# ── Prompt generation ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Image generation ─────────────────────────────────────────────────────────
# Pollinations.ai (nano banana) — FREE, no key needed
# Used by default for step 3 (image) in the pipeline.

# Replicate — needed for step 4 (video) via Stable Video Diffusion
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Stability AI — alternative image backend
STABILITY_API_KEY=your_stability_api_key_here

# Active image backend for the Generate tab: replicate | stability | mock
IMAGE_BACKEND=mock

# ── Video generation ─────────────────────────────────────────────────────────
# Replicate SVD (Stable Video Diffusion) — used automatically when
# REPLICATE_API_TOKEN is set and video generation is enabled.
# No extra key needed — same token as above.

# ── Google Sheets export ─────────────────────────────────────────────────────
# Option A: Service Account JSON file path
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service_account.json

# Option B: Service Account JSON content (inline, for Docker / CI)
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account",...}

# Option C: OAuth credentials file (Desktop app, personal use)
# GOOGLE_OAUTH_CREDENTIALS=/path/to/credentials.json

# ── Output ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
