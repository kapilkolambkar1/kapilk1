# Anthropic API key (for prompt generation from script dialogs)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Replicate API key (for image generation via Stable Diffusion / SDXL)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Image generation backend: "replicate" or "stability"
IMAGE_BACKEND=replicate

# Stability AI API key (alternative image backend)
STABILITY_API_KEY=your_stability_api_key_here

# Output directory for generated images
OUTPUT_DIR=output
